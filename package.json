{
  "name": "taipei-mayoral-debate-2026",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:browser": "bun run build && node --test tests/browser_fact_checks.mjs",
    "check": "biome check --error-on-warnings . && bun run typecheck",
    "build": "bun run build:assets && bun run build:site",
    "build:site": "uv run --no-project python -m transcripts.site",
    "build:assets": "bun run check && bun run scripts/build-web.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/themes": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
